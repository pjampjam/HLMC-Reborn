[Unit]
Description=Holy Lois Discord bot (status, chat bridge)
Wants=network-online.target
After=network-online.target minecraft.service

[Service]
ExecStart=/opt/holylois-bot/venv/bin/python /opt/holylois-bot/bot.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/holylois /run/minecraft-console.fifo

[Install]
WantedBy=multi-user.target
